[Unit]
Description=Карта света (Донецк): страница, приём отметок, статус улиц
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/karta-sveta
Environment=KARTA_HOST=127.0.0.1
Environment=KARTA_PORT=8765
Environment=KARTA_QUIET=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/karta-sveta/data

[Install]
WantedBy=multi-user.target
