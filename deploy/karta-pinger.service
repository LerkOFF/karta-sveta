[Unit]
Description=Карта света: датчики, пинг роутеров и решение «есть свет или нет»
After=network-online.target karta-sveta.service
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/karta-sveta
Environment=KARTA_PORT=8765
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 scripts/pinger.py
Restart=always
RestartSec=10
# ping нужны права на сырые сокеты; при NoNewPrivileges файловые права ping не работают
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/karta-sveta/data

[Install]
WantedBy=multi-user.target
